# Set the default behavior, in case people don't have core.autocrlf set.
* text=auto

# Explicitly declare text files you want to always be normalized and converted
# to native line endings on checkout.
*.cpp text
*.h text
*.hpp text
*.c text
*.rc text
*.txt text
*.sln text
*.vcxproj text
*.filters text
*.xml text
*.manifest text

# Keep auto-generated resource header byte-exact (prevents UTF-16 corruption churn)
GameServer/GameServer/resource.h -text

# Declare files that will always have CRLF line endings on checkout.
*.sln text eol=crlf
*.vcxproj text eol=crlf
*.filters text eol=crlf

# Denote all files that are truly binary and should not be modified.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mov binary
*.mp4 binary
*.mp3 binary
*.flv binary
*.fla binary
*.swf binary
*.gz binary
*.zip binary
*.7z binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.eot binary
*.lib binary
*.dll binary
*.exe binary
*.pdb binary
*.obj binary
*.aps binary
*.res binary
