# Visual Studio GitIgnore
## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## Get latest from https://github.com/github/gitignore/blob/main/VisualStudio.gitignore

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono auto generated files
mono_crash.*

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio 2015/2017/2019/2022 cache/options directory
.vs/
# Uncomment if you use Visual Studio Code
#.vscode/

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUNIT
*.VisualState.xml
TestResult.xml
nunit-*.xml

# Build Coverage Results
*.coverage
*.coveragexml

# SQL Server files
*.mdf
*.ldf
*.ndf

# Business Intelligence projects
*.rdl.data
*.bim.layout
*.bim_*.settings
*.rptproj.bak

# Microsoft Azure Build Output
csx/
*.cscfg
*.csdef
*.ossymb
*.ssymb

# ClickOnce directory:
publish/

# Publish Web Output
*.publish.xml
*.model.xml
*.azurePubxml
# *.pubxml - Subscriptions contains sensitive information
*.pubxml.user

# OTF/TTF fonts
*.otf
*.ttf

# Others
*.Cache
ClientBin/
~$*
*~
*.dbmdl
*.dbproj.schemaview
*.jfm
*.pfx
*.publishsettings
orleans.dot

# Including Python binary cache directories
__pycache__/
*.pyc
*.pyo

# WebBench results
.webbench/

# NuGet Packages
*.nupkg
# NuGet Symbol Packages
*.snupkg
# The packages folder can be ignored because of Package Restore
**/[Pp]ackages/*
# except build/, which is used as an MSBuild target.
!**/[Pp]ackages/build/
# Uncomment if using NuGet repositories to store project specific packages (not recommended)
# !packages/

# Application Insights config file
ApplicationInsights.config

# Metadata used by Visual Studio components from any directory
.vshost.exe
.vshost.exe.config
.vshost.exe.manifest
.libgrep
*.swp
*.detached

# Visual Studio Studio Code
.vscode/

# JetBrains Resharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# JetBrains Rider
.idea/

# Visual Studio build variables
ecp.rid

# Direct2D log files
D2DDebug.log

# Telerik's JustMock configuration file
JustMock_Configuration.xml

# Microsoft Azure Project NuGet Packages
**.nxpro

# Team Foundation Error Log
*.utp

# Roslyn Analyzer codegen
*.advisories.json

# Built-in CMake support
CMakeSettings.json
CMakePresets.json

# Microsoft Fakes
FakesAssemblies/

# GhostDoc plugin setting file
*.GhostDoc.xml

# Node.js
node_modules/

# Visual Studio 2017+ Auto-generated files
Generated\ Files/

# GhostDoc plugin setting file
*.GhostDoc.xml

# Visual Studio Auto-generated files
AppPackages/
BundleArtifacts/
Package.StoreAssociation.xml
_pkginfo.txt
*.appx
*.appxbundle
*.appxcopy
*.msix
*.msixbundle
*.msixcopy

# Clang-format file
.clang-format

# C++ files
*.aps
*.idb
*.intermediate.manifest
*.iobj
*.isym
*.lastbuildstate
*.log
*.ltcg.out
*.obj
*.pch
*.pdb
*.tlog
*.vspscc
*.vssscc
*.exp
*.map
*.res
*.tlb
*.tlh
*.bak
*.cache
*.ilk
*.lib
*.sbr
*.sdf
*.ipch
*.db
*.opendb

# Local baseline snapshot folder
GameServe_ORIG/

# Local helper folders
Util/
scripts/

# Local planning/rules files
/.trae/rules/rule2.md
/.trae/rules/rules.md
/GameServer/GUI_XML_EDITOR_PLAN.md
/GameServer/Data/
