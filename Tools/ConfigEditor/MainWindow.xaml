<Window x:Class="ConfigEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ConfigEditor S6E3"
        Height="760"
        Width="1280"
        MinHeight="640"
        MinWidth="1024">
    <DockPanel LastChildFill="True">
        <ToolBar DockPanel.Dock="Top">
            <Button Content="Open" Click="OpenClick" Margin="2"/>
            <Button Content="Validate" Click="ValidateClick" Margin="2"/>
            <Button Content="Save" Click="SaveClick" Margin="2"/>
            <Button Content="Backup" Click="BackupClick" Margin="2"/>
            <Separator/>
            <TextBlock Text="File:" VerticalAlignment="Center" Margin="8,0,4,0"/>
            <TextBlock Name="CurrentFileText" VerticalAlignment="Center"/>
        </ToolBar>

        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock Name="StatusText" Text="Ready"/>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="#DDDDDD" Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Files" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TreeView Name="FilesTree" SelectedItemChanged="FilesTreeSelected"/>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" BorderThickness="0,0,1,0" BorderBrush="#DDDDDD" Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Records" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TabControl>
                        <TabItem Header="Таблица">
                            <DataGrid Name="RecordsGrid"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="False"
                                      SelectionMode="Single"
                                      CanUserReorderColumns="True"
                                      CanUserResizeColumns="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      FrozenColumnCount="1"
                                      HorizontalScrollBarVisibility="Auto"
                                      SelectionChanged="RecordsSelectionChanged"/>
                        </TabItem>
                        <TabItem Header="Форма">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Name="EditorPanel"/>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="220"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Top" Text="Property Inspector" FontWeight="Bold" Margin="0,0,0,8"/>
                        <DataGrid Name="InspectorGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="100"/>
                                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="90"/>
                                <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <DockPanel Grid.Row="1">
                        <TextBlock DockPanel.Dock="Top" Text="Как редактировать" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBox Name="GuideText"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"/>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
